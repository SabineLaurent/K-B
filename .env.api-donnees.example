# The secrets of the service api-donnees of compose.yaml (issue #419). Copy to .env.api-donnees
# (ignored by git) and fill in. Never commit real values. Each variable is described in
# .env.example.

# The base of the compose, with the password of .env.postgres:
#   postgresql://kb:<password>@postgres:5432/k_b
KB_DATABASE_URL=
# The key of the operator, for the requests from the host. Make each key with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
KB_DATA_API_KEY_TERMINAL=
# The key of the AI API: the same value as in .env.api-ia.
KB_DATA_API_KEY_AI_DIGEST=
