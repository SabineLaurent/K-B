ntityRelationEdgeStyle;html=1;endArrow=ERmandOne;startArrow=ERzeroToOne;endFill=0;startFill=0;fontStyle=2;" edge="1" parent="1" source="advisory" target="item"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e78" value="DÉCRIRE" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERzeroToOne;startArrow=ERzeroToOne;endFill=0;startFill=0;fontStyle=2;" edge="1" parent="1" source="publication" target="item"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e79" value="RECENSER" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERzeroToOne;startArrow=ERzeroToOne;endFill=0;startFill=0;fontStyle=2;" edge="1" parent="1" source="vulnerability" target="item"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e80" value="RÉSUMER" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERzeroToOne;startArrow=ERzeroToMany;endFill=0;startFill=0;fontStyle=2;" edge="1" parent="1" source="newsletter_article" target="publication"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e81" value="CITER" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERzeroToOne;startArrow=ERzeroToMany;endFill=0;startFill=0;fontStyle=2;" edge="1" parent="1" source="advisory" target="vulnerability"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e82" value="PUBLIER" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmandOne;startArrow=ERzeroToMany;endFill=0;startFill=0;fontStyle=2;" edge="1" parent="1" source="release" target="tracked_repository"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e83" value="PRODUIRE" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmandOne;startArrow=ERzeroToMany;endFill=0;startFill=0;fontStyle=2;" edge="1" parent="1" source="trend" target="raw_data"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="title" value="&lt;b&gt;K-B — MLD (2026-10-08)&lt;/b&gt;&lt;br&gt;PK : clé primaire technique. FK : clé étrangère. UQ : contrainte d'unicité (identifiant naturel).&lt;br&gt;Données calculées absentes : URL déduites, rangs, nom du fichier brut, « faille exploitée »." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="-130" width="900" height="90" as="geometry" /></mxCell><mxCell id="rules" value="&lt;b&gt;Règles portées par des contraintes&lt;/b&gt;&lt;br&gt;• kind ∈ (paper, newsletter_article, vulnerability, advisory, release) : CHECK.&lt;br&gt;• Exclusivité des sous-types : FK composée (item_id, kind) vers item (id, kind), kind fixé dans chaque sous-type.&lt;br&gt;• publication, vulnerability : colonnes de la source qui fait foi remplies si et seulement si item_id l'est (CHECK).&lt;br&gt;• Longueurs maximales : CHECK (length(col) &lt;= n), comme Pydantic.&lt;br&gt;• trend vient d'une donnée brute de gh_archive (raw_data_id) ; ce n'est pas un item." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="820" height="150" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>