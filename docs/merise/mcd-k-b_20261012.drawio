<mxfile host="drawio"><diagram id="MCD K-B 2026-10-12" name="MCD K-B 2026-10-12"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;K-B — MCD au 2026-10-12, tiré de la base que le code utilise&lt;/b&gt;&lt;br&gt;Identifiant souligné. Les sous-entités de ITEM héritent de son identifiant. (1,1) entre parenthèses : identification relative." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#ffffff;strokeColor=#666666;" parent="1" vertex="1"><mxGeometry x="-400" y="-260" width="1100" height="70" as="geometry"/></mxCell><mxCell id="key" value="&lt;b&gt;Couleurs&lt;/b&gt; (doublées d'une mention écrite) :&lt;br&gt;&amp;#9632; &lt;b&gt;vert&lt;/b&gt; : dans la base créée par &lt;code&gt;kb create-db&lt;/code&gt;, et lu ou écrit par le code de &lt;code&gt;src/k_b&lt;/code&gt; ;&lt;br&gt;&amp;#9632; &lt;b&gt;orange&lt;/b&gt; : dans la base, mais aucun code ne le lit ni ne l'écrit (mention « base, sans code ») ;&lt;br&gt;&amp;#9632; &lt;b&gt;bleu, trait pointillé&lt;/b&gt; : prévu par le journal ADR ou une issue ouverte, absent de la base (mention « prévu »)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#ffffff;strokeColor=#666666;" parent="1" vertex="1"><mxGeometry x="1400" y="-260" width="900" height="110" as="geometry"/></mxCell><mxCell id="source" value="SOURCE" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;collapsible=0;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1"><mxGeometry x="0" y="0" width="300" height="160" as="geometry"/></mxCell><mxCell id="source_r0" value="id_source" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;whiteSpace=wrap;fontStyle=4;" parent