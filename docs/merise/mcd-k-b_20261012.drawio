ative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="e31" value="" style="endArrow=none;html=1;strokeColor=#82b366;strokeWidth=1.5;" parent="1" edge="1" source="vulnerability" target="recenser"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l32" value="0,1" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontStyle=1;labelBackgroundColor=#ffffff;" parent="e31" vertex="1" connectable="0"><mxGeometry x="-0.55" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="resumer" value="RÉSUMER" style="ellipse;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;" parent="1" vertex="1"><mxGeometry x="880" y="790" width="150" height="50" as="geometry"/></mxCell><mxCell id="e33" value="" style="endArrow=none;html=1;strokeColor=#6c8ebf;strokeWidth=1.5;dashed=1;" parent="1" edge="1" source="newsletter" target="resumer"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l34" value="0,1" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontStyle=1;labelBackgroundColor=#ffffff;" parent="e33" vertex="1" connectable="0"><mxGeometry x="-0.55" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="e35" value="" style="endArrow=none;html=1;strokeColor=#6c8ebf;strokeWidth=1.5;dashed=1;" parent="1" edge="1" source="publication" target="resumer"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l36" value="0,n" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontStyle=1;labelBackgroundColor=#ffffff;" parent="e35" vertex="1" connectable="0"><mxGeometry x="-0.55" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="citer" value="CITER" style="ellipse;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1"><mxGeometry x="1270" y="1180" width="150" height="50" as="geometry"/></mxCell><mxCell id="e37" value="" style="endArrow=none;html=1;strokeColor=#82b366;strokeWidth=1.5;" parent="1" edge="1" source="advisory" target="citer"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l38" value="0,1" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontStyle=1;labelBackgroundColor=#ffffff;" parent="e37" vertex="1" connectable="0"><mxGeometry x="-0.55" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="e39" value="" style="endArrow=none;html=1;strokeColor=#82b366;strokeWidth=1.5;" parent="1" edge="1" source="vulnerability" target="citer"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l40" value="0,n" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontStyle=1;labelBackgroundColor=#ffffff;" parent="e39" vertex="1" connectable="0"><mxGeometry x="-0.55" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="publier" value="PUBLIER" style="ellipse;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1"><mxGeometry x="-125" y="1180" width="150" height="50" as="geometry"/></mxCell><mxCell id="e41" value="" style="endArrow=none;html=1;strokeColor=#82b366;strokeWidth=1.5;" parent="1" edge="1" source="tracked" target="publier"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l42" value="0,n" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontStyle=1;labelBackgroundColor=#ffffff;" parent="e41" vertex="1" connectable="0"><mxGeometry x="-0.55" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="e43" value="" style="endArrow=none;html=1;strokeColor=#82b366;strokeWidth=1.5;" parent="1" edge="1" source="release" target="publier"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l44" value="1,1" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontStyle=1;labelBackgroundColor=#ffffff;" parent="e43" vertex="1" connectable="0"><mxGeometry x="-0.55" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="xt" value="X" style="triangle;direction=north;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1"><mxGeometry x="615" y="580" width="70" height="60" as="geometry"/></mxCell><mxCell id="e45" value="" style="endArrow=none;html=1;strokeColor=#82b366;strokeWidth=1.5;" parent="1" edge="1" source="item" target="xt"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e46" value="" style="endArrow=none;html=1;strokeColor=#82b366;strokeWidth=1.5;" parent="1" edge="1" source="xt" target="release"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e47" value="" style="endArrow=none;html=1;strokeColor=#82b366;strokeWidth=1.5;" parent="1" edge="1" source="xt" target="advisory"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e48" value="" style="endArrow=none;html=1;strokeColor=#6c8ebf;strokeWidth=1.5;dashed=1;" parent="1" edge="1" source="xt" target="newsletter"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rules" value="&lt;b&gt;Règles : qui les tient&lt;/b&gt;&lt;br&gt;&amp;#8226; &lt;b&gt;X (exclusion) sur ITEM, tenue par la base&lt;/b&gt; pour RELEASE et ALERTE GITHUB : clé étrangère &lt;code&gt;(item_id, kind) → item (id, kind)&lt;/code&gt; et &lt;code&gt;CHECK kind = 'release'&lt;/code&gt; / &lt;code&gt;'advisory'&lt;/code&gt;. Pas de T (totalité) : un item &lt;code&gt;paper&lt;/code&gt; ou &lt;code&gt;vulnerability&lt;/code&gt; n'a pas de sous-entité.&lt;br&gt;&amp;#8226; &lt;b&gt;Tenu par le code Python, pas par la base&lt;/b&gt; : l'item d'une PUBLICATION est de type &lt;code&gt;paper&lt;/code&gt; (&lt;code&gt;import_items.py:281&lt;/code&gt;), celui d'une VULNÉRABILITÉ de type &lt;code&gt;vulnerability&lt;/code&gt; (&lt;code&gt;import_items.py:323&lt;/code&gt;) ; un seul écrivain par type d'item (&lt;code&gt;WRITER_BY_KIND&lt;/code&gt;, &lt;code&gt;import_items.py:458&lt;/code&gt;). La base ne contrôle pas le type de l'item visé par &lt;code&gt;publication.item_id&lt;/code&gt; ni &lt;code&gt;vulnerability.item_id&lt;/code&gt;.&lt;br&gt;&amp;#8226; DÉCRIRE et RECENSER (0,1) côté PUBLICATION et VULNÉRABILITÉ : &lt;code&gt;item_id&lt;/code&gt; peut être NULL (papier cité avant arXiv, CVE créé par une alerte), et un &lt;code&gt;CHECK&lt;/code&gt; impose alors les autres attributs NULL.&lt;br&gt;&amp;#8226; RELEASE et ALERTE GITHUB ont aussi leur propre colonne &lt;code&gt;id&lt;/code&gt; dans la base (voir le MLD).&lt;br&gt;&amp;#8226; « type d'item » accepte &lt;code&gt;newsletter_article&lt;/code&gt; (orange, sans table). DÉPÔT n'a pas de valeur dans ce &lt;code&gt;CHECK&lt;/code&gt;.&lt;br&gt;&amp;#8226; SURLIGNAGE, DÉPÔT, GAIN D'ÉTOILES : suppression en cascade (&lt;code&gt;ON DELETE CASCADE&lt;/code&gt;). Noms des associations orange (ANNOTER, CORRESPONDRE, GAGNER) donnés pour ce dessin.&lt;br&gt;&amp;#8226; ARTICLE DE NEWSLETTER → PUBLICATION facultatif (ADR du 2026-10-07).&lt;br&gt;&lt;br&gt;&lt;b&gt;Preuves&lt;/b&gt; : base créée le 2026-10-12 par &lt;code&gt;KB_DATA_DIR=&amp;lt;dossier temporaire&amp;gt; uv run kb create-db&lt;/code&gt;, lue par &lt;code&gt;sqlite_master&lt;/code&gt;, &lt;code&gt;PRAGMA table_info&lt;/code&gt;, &lt;code&gt;foreign_key_list&lt;/code&gt;, &lt;code&gt;index_list&lt;/code&gt;. Code : &lt;code&gt;grep -rnE &quot;(INSERT INTO|UPDATE|FROM|JOIN) +&amp;lt;table&amp;gt;&quot; src/k_b&lt;/code&gt;.&lt;br&gt;Vert : &lt;code&gt;source&lt;/code&gt; (&lt;code&gt;seed_sources.sql:4&lt;/code&gt;, &lt;code&gt;import_items.py:61, 473&lt;/code&gt;), &lt;code&gt;raw_data&lt;/code&gt; (&lt;code&gt;import_items.py:60, 111, 478, 488&lt;/code&gt;), &lt;code&gt;item&lt;/code&gt; (&lt;code&gt;:64, 98, 104, 110, 435, 446&lt;/code&gt;), &lt;code&gt;publication&lt;/code&gt; (&lt;code&gt;:43, 276&lt;/code&gt;), &lt;code&gt;vulnerability&lt;/code&gt; (&lt;code&gt;:71, 310, 410, 414&lt;/code&gt;), &lt;code&gt;tracked_repository&lt;/code&gt; (&lt;code&gt;:118, 371&lt;/code&gt;), &lt;code&gt;release&lt;/code&gt; (&lt;code&gt;:99, 126, 364&lt;/code&gt;), &lt;code&gt;advisory&lt;/code&gt; (&lt;code&gt;:105, 132, 402&lt;/code&gt;).&lt;br&gt;Orange : &lt;code&gt;highlight&lt;/code&gt;, &lt;code&gt;repository&lt;/code&gt;, &lt;code&gt;star_gain&lt;/code&gt; (aucune occurrence dans &lt;code&gt;src/k_b&lt;/code&gt; hors &lt;code&gt;schema.sql&lt;/code&gt;) ; &lt;code&gt;vulnerability.withdrawn_at&lt;/code&gt; (aucune écriture ; « withdrawn_at is #106 », &lt;code&gt;import_items.py:70&lt;/code&gt;) ; la valeur &lt;code&gt;'newsletter_article'&lt;/code&gt; de &lt;code&gt;item.kind&lt;/code&gt; (aucune table, aucun écrivain dans &lt;code&gt;WRITER_BY_KIND&lt;/code&gt;, &lt;code&gt;import_items.py:458&lt;/code&gt;).&lt;br&gt;Bleu : TENDANCE / &lt;code&gt;trend&lt;/code&gt; (ADR du 2026-10-08, critère de #142 ; totaux : #143) ; ARTICLE DE NEWSLETTER (ADR du 2026-10-07, critère de #57). &lt;code&gt;repository&lt;/code&gt; et &lt;code&gt;star_gain&lt;/code&gt; : remplacées par &lt;code&gt;trend&lt;/code&gt; selon #142, retrait non décidé (question ouverte du journal ADR, 2026-10-10)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#ffffff;strokeColor=#666666;" parent="1" vertex="1"><mxGeometry x="1400" y="-130" width="900" height="900" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
