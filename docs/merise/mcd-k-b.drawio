lign=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1500" y="1260" width="620" height="80" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>