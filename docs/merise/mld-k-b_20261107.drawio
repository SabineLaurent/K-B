                <mxCell id="heading" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontFamily=Helvetica;fontSize=20;fontColor=#000000;" value="&quot;K-B&quot; - Modèle Logique de Données" vertex="1">
