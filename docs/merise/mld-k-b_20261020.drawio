ontSize=11;" parent="author" vertex="1"><mxGeometry y="38" width="400" height="24" as="geometry"/></mxCell><mxCell id="author_r1" value="&lt;b&gt;publication_id&lt;/b&gt; : FK → publication (id), NOT NULL &lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;absente du MPD&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;whiteSpace=wrap;fontSize=11;" parent="author" vertex="1"><mxGeometry y="62" width="400" height="40" as="geometry"/></mxCell><mxCell id="author_r2" value="&lt;b&gt;rank&lt;/b&gt; : NOT NULL &lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;l. 62&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;whiteSpace=wrap;fontSize=11;" parent="author" vertex="1"><mxGeometry y="102" width="400" height="24" as="geometry"/></mxCell><mxCell id="author_r3" value="&lt;b&gt;name&lt;/b&gt; : NOT NULL &lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;l. 63-66&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;whiteSpace=wrap;fontSize=11;" parent="author" vertex="1"><mxGeometry y="126" width="400" height="24" as="geometry"/></mxCell><mxCell id="author_r4" value="&lt;b&gt;UNIQUE (publication_id, rank)&lt;/b&gt; &lt;font color=&quot;#777777&quot; style=&quot;font-size:10px&quot;&gt;absente du MPD&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;whiteSpace=wrap;fontSize=11;" parent="author" vertex="1"><mxGeometry y="150" width="400" height="24" as="geometry"/></mxCell><mxCell id="author_r5" value="&lt;i&gt;&lt;font color=&quot;#666666&quot;&gt;MPD : liste JSON publication.authors (l. 63-66), dans l&amp;#x27;ordre d&amp;#x27;arXiv (l. 62).&lt;/font&gt;&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;whiteSpace=wrap;fontSize=11;" parent="author" vertex="1"><mxGeometry y="174" width="400" height="40" as=