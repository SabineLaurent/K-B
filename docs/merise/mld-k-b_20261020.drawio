dth=1.5;rounded=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3125;entryDx=0;entryDy=0;" parent="1" source="advisory_r0" target="item_r0" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1395" y="942.0"/><mxPoint x="1395" y="68.0"/></Array></mxGeometry></mxCell><mxCell id="e12" style="endArrow=block;html=1;strokeColor=#444444;strokeWidth=1.5;rounded=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.3125;entryDx=0;entryDy=0;" parent="1" source="newsletter_article_r0" target="item_r0" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1857" y="930.0"/><mxPoint x="1857" y="68.0"/></Array></mxGeometry></mxCell><mxCell id="e13" style="endArrow=block;html=1;strokeColor=#444444;strokeWidth=1.5;rounded=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.4375;entryDx=0;entryDy=0;" parent="1" source="zotero_entry_r0" target="item_r0" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2337" y="942.0"/><mxPoint x="2337" y="644"/><mxPoint x="1866" y="644"/><mxPoint x="1866" y="80.0"/></Array></mxGeometry></mxCell><mxCell id="e14" style="endArrow=block;html=1;strokeColor=#444444;strokeWidth=1.5;rounded=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.125;entryDx=0;entryDy=0;" parent="1" source="highlight_r7" target="zotero_entry_r0" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2346" y="544.0"/><mxPoint x="2346" y="924.0"/></Array></mxGeometry></mxCell><mxCell id="e15" style="endArrow=block;html=1;strokeColor=#444444;strokeWidth=1.5;rounded=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.125;entryDx=0;entryDy=0;" parent="1" source="affected_package_r1" target="advisory_r0" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1404" y="1480.0"/><mxPoint x="1404" y="924.0"/></Array></mxGeometry></mxCell><mxCell id="e16" style="endArrow=block;html=1;strokeColor=#444444;strokeWidth=1.5;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.125;entryDx=0;entryDy=0;" parent="1" source="advisory_r2" target="vulnerability_r0" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1875" y="1002.0"/><mxPoint x="1875" y="1442.0"/></Array></mxGeometry></mxCell><mxCell id="e17" style="endArrow=block;html=1;strokeColor=#444444;strokeWidth=1.5;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.1;entryDx=0;entryDy=0;" parent="1" source="newsletter_article_r7" target="publication_r0" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2355" y="1098.0"/><mxPoint x="2355" y="1442.0"/></Array></mxGeometry></mxCell><mxCell id="e18" style="endArrow=block;html=1;strokeColor=#444444;strokeWidth=1.5;rounded=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" parent="1" source="zotero_entry_r6" target="publication_r0" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2364" y="1098.0"/><mxPoint x="2364" y="1454.0"/></Array></mxGeometry></mxCell><mxCell id="e19" style="endArrow=block;html=1;strokeColor=#444444;strokeWidth=1.5;rounded=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.7333333333333333;entryDx=0;entryDy=0;" parent="1" source="author_r1" target="publication_r0" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2808" y="1480.0"/><mxPoint x="2808" y="1480.0"/></Array></mxGeometry></mxCell><mxCell id="e20" style="endArrow=block;html=1;strokeColor=#444444;strokeWidth=1.5;rounded=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5625;entryDx=0;entryDy=0;" parent="1" source="vulnerability_r2" target="item_r0" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1884" y="1520.0"/><mxPoint x="1884" y="92.0"/></Array></mxGeometry></mxCell><mxCell id="e21" style="endArrow=block;html=1;strokeColor=#444444;strokeWidth=1.5;rounded=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.6875;entryDx=0;entryDy=0;" parent="1" source="publication_r2" target="item_r0" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2373" y="1532.0"/><mxPoint x="2373" y="1212"/><mxPoint x="1893" y="1212"/><mxPoint x="1893" y="104.0"/></Array></mxGeometry></mxCell><mxCell id="heading" value="&quot;K-B&quot; - Modèle Logique de Données" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=20;" parent="1" vertex="1"><mxGeometry x="0" y="-400" width="3200" height="40" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;Déduit du MCD (&lt;code&gt;mcd-k-b_20261020.drawio&lt;/code&gt;) par les règles de passage, le 2026-10-20.&lt;/b&gt; Une entité donne une table, son identifiant la clé primaire &lt;code&gt;id&lt;/code&gt; ; une association (0,N) ou (1,N)–(1,1) donne une clé étrangère obligatoire du côté (1,1) ; (0,1)–(0,N), une clé étrangère facultative du côté (0,1) ; (0,1)–(0,1), une clé étrangère &lt;code&gt;UNIQUE&lt;/code&gt; facultative ; (0,N)–(1,N), une table de liaison &lt;code&gt;&amp;lt;a&amp;gt;_has_&amp;lt;b&amp;gt;&lt;/code&gt; à clé composée ; une sous-entité prend pour clé primaire l&#x27;identifiant d&#x27;Item, &lt;code&gt;item_id&lt;/code&gt;. Chaque table et colonne renvoie à ses lignes de &lt;code&gt;src/k_b/database/schema.sql&lt;/code&gt; (le MPD, origin/main d540499) quand elle y est (« l. ») ; en gris, l&#x27;écart avec le MPD. Clé primaire soulignée. Une flèche va de la clé étrangère à la clé primaire qu&#x27;elle vise. Noms : ceux de &lt;code&gt;schema.sql&lt;/code&gt;, sauf là où la convention (clé primaire &lt;code&gt;id&lt;/code&gt;, clé étrangère &lt;code&gt;&amp;lt;table&amp;gt;_id&lt;/code&gt;) l&#x27;emporte : &lt;code&gt;highlight.id&lt;/code&gt;, &lt;code&gt;highlight.zotero_entry_id&lt;/code&gt;, &lt;code&gt;trend.ranking_id&lt;/code&gt; et les tables absentes du MPD ; chaque écart est noté en gris." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#ffffff;strokeColor=#666666;" parent="1" vertex="1"><mxGeometry x="0" y="-340" width="3200" height="140" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Tables absentes du MPD&lt;/b&gt; (fond bleu, mention « absente du MPD ») : &lt;code&gt;ranking&lt;/code&gt;, &lt;code&gt;author&lt;/code&gt;, &lt;code&gt;tracked_package&lt;/code&gt;, &lt;code&gt;affected_package&lt;/code&gt;. Le MPD dénormalise, volontairement : &lt;code&gt;trend&lt;/code&gt; porte la fenêtre et sa donnée brute au lieu de &lt;code&gt;ranking&lt;/code&gt; (2FN : &lt;code&gt;raw_data_id&lt;/code&gt; ne dépend que de &lt;code&gt;window_end&lt;/code&gt;, l. 105-106, tenu par &lt;code&gt;src/k_b/database/writers/trend_writer.py:18-26&lt;/code&gt;) ; trois listes JSON au lieu de trois tables (1FN). Raisons : &lt;code&gt;docs/stockage.md&lt;/code&gt;, « MCD et MLD ».&lt;br&gt;&lt;b&gt;Sous-types&lt;/b&gt; : le MPD leur donne une colonne &lt;code&gt;id&lt;/code&gt;, la colonne &lt;code&gt;kind&lt;/code&gt; et la clé étrangère &lt;code&gt;(item_id, kind) → item (id, kind)&lt;/code&gt;, qui tiennent l&#x27;exclusion X du MCD.&lt;br&gt;Les &lt;code&gt;CHECK&lt;/code&gt; (formes, longueurs, listes de valeurs, dates) et les index sont au MPD seulement." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#ffffff;strokeColor=#666666;" parent="1" vertex="1"><mxGeometry x="0" y="1804" width="3200" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
