ive="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="" style="endArrow=block;html=1;strokeColor=#d79b00;strokeWidth=1.5;" parent="1" edge="1" source="repository_r0" target="item_r0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="" style="endArrow=block;html=1;strokeColor=#d79b00;strokeWidth=1.5;" parent="1" edge="1" source="star_gain_r0" target="repository_r0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="" style="endArrow=block;html=1;strokeColor=#6c8ebf;strokeWidth=1.5;dashed=1;" parent="1" edge="1" source="trend_r6" target="raw_data_r0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e13" value="" style="endArrow=block;html=1;strokeColor=#6c8ebf;strokeWidth=1.5;dashed=1;" parent="1" edge="1" source="newsletter_r1" target="item_r0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="" style="endArrow=block;html=1;strokeColor=#6c8ebf;strokeWidth=1.5;dashed=1;" parent="1" edge="1" source="newsletter_r8" target="publication_r0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="legend" value="&lt;b&gt;Règles tenues par le code Python, pas par la base&lt;/b&gt; : l'item visé par &lt;code&gt;publication.item_id&lt;/code&gt; est de type &lt;code&gt;paper&lt;/code&gt; (&lt;code&gt;import_items.py:281&lt;/code&gt;), celui de &lt;code&gt;vulnerability.item_id&lt;/code&gt; de type &lt;code&gt;vulnerability&lt;/code&gt; (&lt;code&gt;import_items.py:323&lt;/code&gt;) ; un seul écrivain par &lt;code&gt;kind&lt;/code&gt; (&lt;code&gt;WRITER_BY_KIND&lt;/code&gt;, &lt;code&gt;import_items.py:458&lt;/code&gt;). Pour &lt;code&gt;release&lt;/code&gt; et &lt;code&gt;advisory&lt;/code&gt;, la base le tient : FK &lt;code&gt;(item_id, kind)&lt;/code&gt; et &lt;code&gt;CHECK kind&lt;/code&gt;.&lt;br&gt;&lt;br&gt;&lt;b&gt;Preuves&lt;/b&gt; : base créée le 2026-10-12 par &lt;code&gt;KB_DATA_DIR=&amp;lt;dossier temporaire&amp;gt; uv run kb create-db&lt;/code&gt;, lue par &lt;code&gt;sqlite_master&lt;/code&gt;, &lt;code&gt;PRAGMA table_info&lt;/code&gt;, &lt;code&gt;foreign_key_list&lt;/code&gt;, &lt;code&gt;index_list&lt;/code&gt;. Code : &lt;code&gt;grep -rnE &quot;(INSERT INTO|UPDATE|FROM|JOIN) +&amp;lt;table&amp;gt;&quot; src/k_b&lt;/code&gt;.&lt;br&gt;Vert : &lt;code&gt;source&lt;/code&gt; (&lt;code&gt;seed_sources.sql:4&lt;/code&gt;, &lt;code&gt;import_items.py:61, 473&lt;/code&gt;), &lt;code&gt;raw_data&lt;/code&gt; (&lt;code&gt;import_items.py:60, 111, 478, 488&lt;/code&gt;), &lt;code&gt;item&lt;/code&gt; (&lt;code&gt;:64, 98, 104, 110, 435, 446&lt;/code&gt;), &lt;code&gt;publication&lt;/code&gt; (&lt;code&gt;:43, 276&lt;/code&gt;), &lt;code&gt;vulnerability&lt;/code&gt; (&lt;code&gt;:71, 310, 410, 414&lt;/code&gt;), &lt;code&gt;tracked_repository&lt;/code&gt; (&lt;code&gt;:118, 371&lt;/code&gt;), &lt;code&gt;release&lt;/code&gt; (&lt;code&gt;:99, 126, 364&lt;/code&gt;), &lt;code&gt;advisory&lt;/code&gt; (&lt;code&gt;:105, 132, 402&lt;/code&gt;).&lt;br&gt;Orange : &lt;code&gt;highlight&lt;/code&gt;, &lt;code&gt;repository&lt;/code&gt;, &lt;code&gt;star_gain&lt;/code&gt; (aucune occurrence dans &lt;code&gt;src/k_b&lt;/code&gt; hors &lt;code&gt;schema.sql&lt;/code&gt;) ; &lt;code&gt;vulnerability.withdrawn_at&lt;/code&gt; (aucune écriture ; « withdrawn_at is #106 », &lt;code&gt;import_items.py:70&lt;/code&gt;) ; la valeur &lt;code&gt;'newsletter_article'&lt;/code&gt; de &lt;code&gt;item.kind&lt;/code&gt; (aucune table, aucun écrivain dans &lt;code&gt;WRITER_BY_KIND&lt;/code&gt;, &lt;code&gt;import_items.py:458&lt;/code&gt;).&lt;br&gt;Bleu : TENDANCE / &lt;code&gt;trend&lt;/code&gt; (ADR du 2026-10-08, critère de #142 ; totaux : #143) ; ARTICLE DE NEWSLETTER (ADR du 2026-10-07, critère de #57). &lt;code&gt;repository&lt;/code&gt; et &lt;code&gt;star_gain&lt;/code&gt; : remplacées par &lt;code&gt;trend&lt;/code&gt; selon #142, retrait non décidé (question ouverte du journal ADR, 2026-10-10)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#ffffff;strokeColor=#666666;" parent="1" vertex="1"><mxGeometry x="0" y="1180" width="560" height="760" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
