nter;verticalAlign=middle;resizable=0;points=[];fontStyle=1;fontSize=12;labelBackgroundColor=#ffffff;" parent="e26" connectable="0" vertex="1"><mxGeometry x="-0.4" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="toucher" value="TOUCHER&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot; color=&quot;#555555&quot;&gt;l. 214-217&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1.5;" parent="1" vertex="1"><mxGeometry x="1605.0" y="1181.0" width="120" height="56" as="geometry"/></mxCell><mxCell id="e27" style="endArrow=none;html=1;strokeColor=#444444;strokeWidth=1.5;rounded=0;exitX=0.32;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="advisory" target="toucher" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e27_c" value="1,N" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontStyle=1;fontSize=12;labelBackgroundColor=#ffffff;" parent="e27" connectable="0" vertex="1"><mxGeometry x="-0.4" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="e28" style="endArrow=none;html=1;strokeColor=#444444;strokeWidth=1.5;rounded=0;exitX=0.32;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" parent="1" source="affected_package" target="toucher" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e28_c" value="1,1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontStyle=1;fontSize=12;labelBackgroundColor=#ffffff;" parent="e28" connectable="0" vertex="1"><mxGeometry x="-0.4" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="citer" value="CITER&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot; color=&quot;#555555&quot;&gt;l. 205&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1.5;" parent="1" vertex="1"><mxGeometry x="2635.0" y="1680.0" width="130" height="56" as="geometry"/></mxCell><mxCell id="e29" style="endArrow=none;html=1;strokeColor=#444444;strokeWidth=1.5;rounded=0;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="advisory" target="citer" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1985" y="1034.4"/><mxPoint x="1985" y="1708"/></Array></mxGeometry></mxCell><mxCell id="e29_c" value="0,1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontStyle=1;fontSize=12;labelBackgroundColor=#ffffff;" parent="e29" connectable="0" vertex="1"><mxGeometry x="-0.8" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="e30" style="endArrow=none;html=1;strokeColor=#444444;strokeWidth=1.5;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="vulnerability" target="citer" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3285.0" y="1708"/></Array></mxGeometry></mxCell><mxCell id="e30_c" value="0,N" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontStyle=1;fontSize=12;labelBackgroundColor=#ffffff;" parent="e30" connectable="0" vertex="1"><mxGeometry x="-0.6" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="xt" value="X" style="triangle;direction=north;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1.5;verticalAlign=bottom;" parent="1" vertex="1"><mxGeometry x="1685.0" y="250" width="80" height="70" as="geometry"/></mxCell><mxCell id="e31" style="endArrow=none;html=1;strokeColor=#444444;strokeWidth=1.5;rounded=0;" parent="1" source="xt" target="item" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e32" style="endArrow=none;html=1;strokeColor=#444444;strokeWidth=1.5;rounded=0;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" parent="1" source="release" target="xt" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e33" style="endArrow=none;html=1;strokeColor=#444444;strokeWidth=1.5;rounded=0;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" parent="1" source="clip" target="xt" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e34" style="endArrow=none;html=1;strokeColor=#444444;strokeWidth=1.5;rounded=0;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" parent="1" source="advisory" target="xt" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e35" style="endArrow=none;html=1;strokeColor=#444444;strokeWidth=1.5;rounded=0;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" parent="1" source="newsletter" target="xt" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e36" style="endArrow=none;html=1;strokeColor=#444444;strokeWidth=1.5;rounded=0;exitX=0.35;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" parent="1" source="zotero" target="xt" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rules" value="&lt;b&gt;Règles : qui les tient&lt;/b&gt;&lt;br&gt;&amp;#8226; &lt;b&gt;Spécialisation X (exclusion) d&#x27;Item, tenue par la base&lt;/b&gt; : chaque sous-entité a une clé étrangère &lt;code&gt;(item_id, kind) → item (id, kind)&lt;/code&gt; (l. 191, 218, 249, 283, 318) vers &lt;code&gt;UNIQUE (id, kind)&lt;/code&gt; (l. 49), et un &lt;code&gt;CHECK kind = &#x27;…&#x27;&lt;/code&gt; (l. 176, 201, 229, 262, 295) : un item n&#x27;a qu&#x27;un type, donc au plus une sous-entité. Pas de T (totalité) : un item arXiv ou CISA KEV (&lt;code&gt;paper&lt;/code&gt;, &lt;code&gt;vulnerability&lt;/code&gt;, l. 45) n&#x27;a pas de sous-entité, il passe par DÉCRIRE ou RECENSER. Un item est donc dans exactement un des sept cas ; le MPD le dit par la colonne &lt;code&gt;kind&lt;/code&gt; (l. 44-46), que le MCD ne dessine pas : la spécialisation et les deux associations la donnent.&lt;br&gt;&amp;#8226; &lt;b&gt;Tenu par le code, pas par la base&lt;/b&gt; (fichiers sous &lt;code&gt;src/k_b/&lt;/code&gt;) :&lt;br&gt;&amp;#8195;– l&#x27;item de DÉCRIRE est de type &lt;code&gt;paper&lt;/code&gt; (&lt;code&gt;database/writers/paper_writer.py:37-41&lt;/code&gt;), celui de RECENSER de type &lt;code&gt;vulnerability&lt;/code&gt; (&lt;code&gt;vulnerability_writer.py:68-72&lt;/code&gt;) ; la base ne contrôle pas le type de l&#x27;item visé (l. 59, 134) ;&lt;br&gt;&amp;#8195;– un item a sa sous-entité, ou sa publication, ou sa vulnérabilité : un seul écrivain par type écrit les deux ensemble (&lt;code&gt;WRITER_BY_KIND&lt;/code&gt;, &lt;code&gt;database/writing.py:58-66&lt;/code&gt;) ; la base l&#x27;accepte seul (&lt;code&gt;shared_rows.py:44-51&lt;/code&gt;) ;&lt;br&gt;&amp;#8195;– ANNOTER : la clé étrangère du surlignage vise &lt;code&gt;item (id)&lt;/code&gt; (l. 97) ; seule l&#x27;écriture d&#x27;une entrée Zotero écrit un surlignage, avec l&#x27;item de l&#x27;entrée (&lt;code&gt;zotero_entry_writer.py:92-103, 139&lt;/code&gt;) ;&lt;br&gt;&amp;#8195;– PORTER : seul un clip de page web porte des étiquettes à ce jour (&lt;code&gt;clip_writer.py:206-209&lt;/code&gt;) ; Étiquette 1,N : une étiquette dont le dernier lien est retiré est supprimée (&lt;code&gt;clip_writer.py:60-64, 188-191&lt;/code&gt;). Un item n&#x27;est supprimé que par la purge, non codée (#83) ; ses liens partiraient avec lui (l. 335) ;&lt;br&gt;&amp;#8195;– Paquet touché : chaque nom une fois dans l&#x27;alerte (&lt;code&gt;etl/sources/github_advisories.py:166-180&lt;/code&gt;) ; un &lt;code&gt;CHECK&lt;/code&gt; ne lit pas les éléments d&#x27;une liste JSON (l. 12-14) ;&lt;br&gt;&amp;#8195;– Classement : toutes les tendances d&#x27;une fenêtre viennent de la même donnée brute (l. 105-106, &lt;code&gt;trend_writer.py:18-26&lt;/code&gt;).&lt;br&gt;&amp;#8226; &lt;b&gt;Tenu par la base&lt;/b&gt; : DÉCRIRE et RECENSER sont 0,1 côté Publication et Vulnérabilité (publication citée avant qu&#x27;arXiv la donne, CVE créé par une alerte) ; leurs autres propriétés ne sont remplies que si l&#x27;association existe (l. 71-75, 148-154) ; ÉCRIRE : 1 à 1 000 auteurs si DÉCRIRE, aucun sinon (l. 64-66, 73) ; TOUCHER : 1 à 100 paquets (l. 216-217) ; COMPRENDRE : au moins 1 (l. 168) ; Surlignage : texte ou commentaire, l&#x27;un au moins (l. 98).&lt;br&gt;&amp;#8226; Un auteur est une place dans la liste des auteurs d&#x27;une publication, dans l&#x27;ordre d&#x27;arXiv (l. 62), pas une personne : K-B n&#x27;identifie pas les personnes et ne relie pas deux publications par un nom. Un rang n&#x27;apparaît qu&#x27;une fois par publication, comme par dépôt suivi pour un paquet suivi (l&#x27;ordre d&#x27;une liste, l. 62, 165).&lt;br&gt;&amp;#8226; RÉSUMER : la colonne existe, aucune écriture ne la remplit à ce jour (l. 246).&lt;br&gt;&amp;#8226; &lt;b&gt;Le MLD&lt;/b&gt; (&lt;code&gt;mld-k-b_20261020.drawio&lt;/code&gt;) se déduit de ce MCD par les règles de passage. &lt;b&gt;Le MPD&lt;/b&gt; (&lt;code&gt;schema.sql&lt;/code&gt;) s&#x27;en écarte par deux dénormalisations voulues (raisons : &lt;code&gt;docs/stockage.md&lt;/code&gt;, « MCD et MLD ») : Auteur, Paquet suivi et Paquet touché y sont une liste JSON (1FN ; l. 63-66, 166-168, 214-217) ; Classement n&#x27;y a pas de table, &lt;code&gt;trend&lt;/code&gt; porte &lt;code&gt;window_end&lt;/code&gt; et &lt;code&gt;raw_data_id&lt;/code&gt; (2FN ; l. 110-113).&lt;br&gt;&amp;#8226; &lt;b&gt;Disposition&lt;/b&gt; : le sujet du verbe à gauche du complément, ou au-dessus dans la même colonne ; Item au-dessus de ses sous-entités (&lt;code&gt;docs/merise/positions-mcd.md&lt;/code&gt;, qui donne le sujet de chaque association)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fillColor=#ffffff;strokeColor=#666666;" parent="1" vertex="1"><mxGeometry x="0" y="1828" width="2600" height="520" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
