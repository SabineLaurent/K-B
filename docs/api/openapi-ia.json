{
  "openapi": "3.1.0",
  "info": {
    "title": "K-B AI API",
    "version": "0.9.0"
  },
  "paths": {
    "/digests": {
      "post": {
        "tags": [
          "digests"
        ],
        "summary": "Post Digests",
        "description": "The digests of the items of the window, one per subject with items; a subject whose\nwriting fails is named in failed_subjects, a reading or a classification that fails fails\nthe request.",
        "operationId": "post_digests_digests_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DigestRequestSchema"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DigestsSchema"
                }
              }
            }
          },
          "401": {
            "description": "invalid_api_key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorSchema"
                }
              }
            }
          },
          "422": {
            "description": "invalid_parameter",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvalidParameterSchema"
                }
              }
            }
          },
          "413": {
            "description": "content_too_large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorSchema"
                }
              }
            }
          },
          "500": {
            "description": "internal_error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorSchema"
                }
              }
            }
          },
          "502": {
            "description": "data_api_invalid_response, data_api_unauthorized, data_api_unavailable, llm_content_filtered, llm_invalid_output, llm_truncated, llm_unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorSchema"
                }
              }
            }
          },
          "503": {
            "description": "llm_rate_limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorSchema"
                }
              }
            }
          },
          "504": {
            "description": "data_api_timeout, llm_timeout",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorSchema"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/trend-reports": {
      "post": {
        "tags": [
          "trend-reports"
        ],
        "summary": "Post Trend Reports",
        "description": "The repositories that meet a criterion over the windows after the previous report, each\nwith its trajectory, and those the model chose among the candidates read; no window after it\ngives an empty period, a reading that fails fails the request, a choice that fails leaves the\nreport factual, with its state.",
        "operationId": "post_trend_reports_trend_reports_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TrendReportRequestSchema"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrendReportSchema"
                }
              }
            }
          },
          "401": {
            "description": "invalid_api_key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorSchema"
                }
              }
            }
          },
          "422": {
            "description": "invalid_parameter",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvalidParameterSchema"
                }
              }
            }
          },
          "413": {
            "description": "content_too_large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorSchema"
                }
              }
            }
          },
          "500": {
            "description": "internal_error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorSchema"
                }
              }
            }
          },
          "502": {
            "description": "data_api_invalid_response, data_api_unauthorized, data_api_unavailable, github_forbidden, github_invalid_response, github_unauthorized, github_unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorSchema"
                }
              }
            }
          },
          "503": {
            "description": "github_rate_limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorSchema"
                }
              }
            }
          },
          "504": {
            "description": "data_api_timeout, github_timeout",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorSchema"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "CandidatesSchema": {
        "properties": {
          "selected": {
            "type": "integer",
            "title": "Selected",
            "description": "The repositories whose sheet is read on GitHub, 60 at most, those meeting a criterion first; read plus the sum of dropped."
          },
          "read": {
            "type": "integer",
            "title": "Read"
          },
          "dropped": {
            "$ref": "#/components/schemas/DroppedCandidatesSchema",
            "description": "Left out by GitHub, by reason; out of repositories."
          }
        },
        "type": "object",
        "required": [
          "selected",
          "read",
          "dropped"
        ],
        "title": "CandidatesSchema"
      },
      "Caution": {
        "type": "string",
        "enum": [
          "created_recently",
          "no_license"
        ]
      },
      "ChoiceCriterion": {
        "type": "string",
        "enum": [
          "durable",
          "new",
          "accelerating",
          "watch_subject"
        ]
      },
      "ChosenRepositorySchema": {
        "properties": {
          "repository_id": {
            "type": "integer",
            "title": "Repository Id"
          },
          "repository_name": {
            "type": "string",
            "title": "Repository Name",
            "description": "Its name in the most recent window."
          },
          "criteria": {
            "items": {
              "$ref": "#/components/schemas/ChoiceCriterion"
            },
            "type": "array",
            "title": "Criteria",
            "description": "Those the model gave and the code checked, in the order durable, new, accelerating, watch_subject."
          },
          "watch_subjects": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Watch Subjects",
            "description": "With watch_subject only, in the order of the subjects of the watch."
          },
          "best_rank": {
            "type": "integer",
            "title": "Best Rank"
          },
          "trajectory": {
            "items": {
              "$ref": "#/components/schemas/TrajectoryPointSchema"
            },
            "type": "array",
            "title": "Trajectory",
            "description": "One point per window of the period, in its order."
          },
          "facts": {
            "$ref": "#/components/schemas/RepositoryFactsSchema",
            "description": "Read on GitHub."
          }
        },
        "type": "object",
        "required": [
          "repository_id",
          "repository_name",
          "criteria",
          "watch_subjects",
          "best_rank",
          "trajectory",
          "facts"
        ],
        "title": "ChosenRepositorySchema"
      },
      "ClaimSchema": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          },
          "item_ids": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Item Ids"
          }
        },
        "type": "object",
        "required": [
          "text",
          "item_ids"
        ],
        "title": "ClaimSchema"
      },
      "Criterion": {
        "type": "string",
        "enum": [
          "durable",
          "new",
          "accelerating"
        ]
      },
      "DigestRequestSchema": {
        "properties": {
          "window_days": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 14.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Window Days",
            "description": "Absent or null: the window of KB_DIGEST_WINDOW_DAYS."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "DigestRequestSchema"
      },
      "DigestSchema": {
        "properties": {
          "subject": {
            "type": "string",
            "title": "Subject"
          },
          "claims": {
            "items": {
              "$ref": "#/components/schemas/ClaimSchema"
            },
            "type": "array",
            "title": "Claims"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/SourceSchema"
            },
            "type": "array",
            "title": "Sources"
          },
          "items_not_retained_in_output": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Items Not Retained In Output"
          },
          "claims_removed": {
            "type": "integer",
            "title": "Claims Removed"
          },
          "items_removed_by_checks": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Items Removed By Checks"
          }
        },
        "type": "object",
        "required": [
          "subject",
          "claims",
          "sources",
          "items_not_retained_in_output",
          "claims_removed",
          "items_removed_by_checks"
        ],
        "title": "DigestSchema"
      },
      "DigestsSchema": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "model": {
            "type": "string",
            "title": "Model",
            "description": "The model of KB_LLM_MODEL that wrote the digests; replay for the replay."
          },
          "window": {
            "$ref": "#/components/schemas/WindowSchema"
          },
          "digests": {
            "items": {
              "$ref": "#/components/schemas/DigestSchema"
            },
            "type": "array",
            "title": "Digests"
          },
          "failed_subjects": {
            "items": {
              "$ref": "#/components/schemas/FailedSubjectSchema"
            },
            "type": "array",
            "title": "Failed Subjects"
          },
          "no_suitable_subject": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "No Suitable Subject",
            "description": "Items of the classification that no subject suits."
          },
          "unanswered": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Unanswered",
            "description": "Items the classification left without answer, in no digest either."
          },
          "items_in": {
            "type": "integer",
            "title": "Items In"
          },
          "items_truncated": {
            "type": "integer",
            "title": "Items Truncated"
          },
          "items_dropped_before_writing_stage": {
            "type": "integer",
            "title": "Items Dropped Before Writing Stage"
          },
          "items_capped": {
            "type": "boolean",
            "title": "Items Capped"
          }
        },
        "type": "object",
        "required": [
          "request_id",
          "model",
          "window",
          "digests",
          "failed_subjects",
          "no_suitable_subject",
          "unanswered",
          "items_in",
          "items_truncated",
          "items_dropped_before_writing_stage",
          "items_capped"
        ],
        "title": "DigestsSchema"
      },
      "DroppedCandidatesSchema": {
        "properties": {
          "not_found": {
            "type": "integer",
            "title": "Not Found"
          },
          "unavailable_for_legal_reasons": {
            "type": "integer",
            "title": "Unavailable For Legal Reasons"
          },
          "moved": {
            "type": "integer",
            "title": "Moved",
            "description": "A redirection, not followed."
          },
          "id_mismatch": {
            "type": "integer",
            "title": "Id Mismatch",
            "description": "Another repository under the name."
          },
          "forbidden": {
            "type": "integer",
            "title": "Forbidden",
            "description": "A 403 that is not a rate limit."
          }
        },
        "type": "object",
        "required": [
          "not_found",
          "unavailable_for_legal_reasons",
          "moved",
          "id_mismatch",
          "forbidden"
        ],
        "title": "DroppedCandidatesSchema"
      },
      "ErrorSchema": {
        "properties": {
          "error": {
            "type": "string",
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorSchema"
      },
      "FailedSubjectSchema": {
        "properties": {
          "subject": {
            "type": "string",
            "title": "Subject"
          },
          "stage": {
            "$ref": "#/components/schemas/Stage"
          },
          "error": {
            "$ref": "#/components/schemas/LlmFailure"
          }
        },
        "type": "object",
        "required": [
          "subject",
          "stage",
          "error"
        ],
        "title": "FailedSubjectSchema"
      },
      "InvalidParameterSchema": {
        "properties": {
          "error": {
            "type": "string",
            "title": "Error"
          },
          "parameters": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Parameters"
          }
        },
        "type": "object",
        "required": [
          "error",
          "parameters"
        ],
        "title": "InvalidParameterSchema"
      },
      "LlmFailure": {
        "type": "string",
        "enum": [
          "llm_invalid_output",
          "llm_truncated",
          "llm_content_filtered",
          "llm_rate_limited",
          "llm_unavailable",
          "llm_timeout"
        ]
      },
      "RepositoryFactsSchema": {
        "properties": {
          "license": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "License",
            "description": "Its SPDX identifier; null when GitHub recognizes no license."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "language": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Language"
          },
          "topics": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Topics"
          },
          "stars_total": {
            "type": "integer",
            "title": "Stars Total",
            "description": "Read on GitHub at the request, never kept."
          },
          "cautions": {
            "items": {
              "$ref": "#/components/schemas/Caution"
            },
            "type": "array",
            "title": "Cautions",
            "description": "created_recently (less than 7 days before the request), then no_license."
          }
        },
        "type": "object",
        "required": [
          "license",
          "created_at",
          "language",
          "topics",
          "stars_total",
          "cautions"
        ],
        "title": "RepositoryFactsSchema"
      },
      "SourceSchema": {
        "properties": {
          "item_id": {
            "type": "integer",
            "title": "Item Id"
          },
          "kind": {
            "$ref": "#/components/schemas/WatchKind"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          }
        },
        "type": "object",
        "required": [
          "item_id",
          "kind",
          "title",
          "url"
        ],
        "title": "SourceSchema",
        "description": "Read from the data API, never from the output of the model."
      },
      "Stage": {
        "type": "string",
        "enum": [
          "classify",
          "write",
          "select"
        ]
      },
      "TrajectoryPointSchema": {
        "properties": {
          "window_end": {
            "type": "string",
            "format": "date",
            "title": "Window End"
          },
          "state": {
            "$ref": "#/components/schemas/WindowState"
          },
          "rank": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rank",
            "description": "The rank by stars, in the top only."
          },
          "stars_gained": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stars Gained",
            "description": "Counted by GH Archive, a sample of the stars; in the top only."
          }
        },
        "type": "object",
        "required": [
          "window_end",
          "state",
          "rank",
          "stars_gained"
        ],
        "title": "TrajectoryPointSchema"
      },
      "TrendPeriodSchema": {
        "properties": {
          "first_report": {
            "type": "boolean",
            "title": "First Report"
          },
          "windows": {
            "items": {
              "type": "string",
              "format": "date"
            },
            "type": "array",
            "title": "Windows",
            "description": "The windows of the report, the oldest first, the missing ones included."
          },
          "missing_windows": {
            "items": {
              "type": "string",
              "format": "date"
            },
            "type": "array",
            "title": "Missing Windows"
          },
          "windows_capped": {
            "type": "boolean",
            "title": "Windows Capped",
            "description": "Older windows after the previous report left out."
          },
          "new_evaluated": {
            "type": "boolean",
            "title": "New Evaluated",
            "description": "False for the first report, and when every window of the previous report is missing."
          },
          "latest_window": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latest Window",
            "description": "The latest window in the base; null when it has none."
          }
        },
        "type": "object",
        "required": [
          "first_report",
          "windows",
          "missing_windows",
          "windows_capped",
          "new_evaluated",
          "latest_window"
        ],
        "title": "TrendPeriodSchema"
      },
      "TrendReportRequestSchema": {
        "properties": {
          "after": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "After",
            "description": "The last window of the previous report; null for the first report."
          },
          "previous_first_window": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Previous First Window",
            "description": "The first window of the previous report; null with after only."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "after",
          "previous_first_window"
        ],
        "title": "TrendReportRequestSchema"
      },
      "TrendReportSchema": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model",
            "description": "The model that chose the repositories, none chosen included; null when the choice failed or no candidate was read."
          },
          "choice_failure": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LlmFailure"
              },
              {
                "type": "null"
              }
            ],
            "description": "The state of a choice that failed; null otherwise. The report stays factual."
          },
          "chosen": {
            "items": {
              "$ref": "#/components/schemas/ChosenRepositorySchema"
            },
            "type": "array",
            "title": "Chosen",
            "description": "5 at most, in the order of the model; one chosen by watch_subject alone may be out of repositories."
          },
          "period": {
            "$ref": "#/components/schemas/TrendPeriodSchema"
          },
          "repositories": {
            "items": {
              "$ref": "#/components/schemas/TrendRepositorySchema"
            },
            "type": "array",
            "title": "Repositories",
            "description": "Those meeting a criterion, by best rank then repository_id, but the candidates GitHub left out."
          },
          "repositories_dropped": {
            "type": "integer",
            "title": "Repositories Dropped",
            "description": "Repositories meeting a criterion left out, their name `.` or with `..`."
          },
          "candidates": {
            "$ref": "#/components/schemas/CandidatesSchema"
          }
        },
        "type": "object",
        "required": [
          "request_id",
          "model",
          "choice_failure",
          "chosen",
          "period",
          "repositories",
          "repositories_dropped",
          "candidates"
        ],
        "title": "TrendReportSchema"
      },
      "TrendRepositorySchema": {
        "properties": {
          "repository_id": {
            "type": "integer",
            "title": "Repository Id"
          },
          "repository_name": {
            "type": "string",
            "title": "Repository Name",
            "description": "Its name in the most recent window."
          },
          "criteria": {
            "items": {
              "$ref": "#/components/schemas/Criterion"
            },
            "type": "array",
            "title": "Criteria"
          },
          "best_rank": {
            "type": "integer",
            "title": "Best Rank"
          },
          "trajectory": {
            "items": {
              "$ref": "#/components/schemas/TrajectoryPointSchema"
            },
            "type": "array",
            "title": "Trajectory",
            "description": "One point per window of the period, in its order."
          },
          "facts": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RepositoryFactsSchema"
              },
              {
                "type": "null"
              }
            ],
            "description": "Read on GitHub; null when the repository is not a candidate."
          }
        },
        "type": "object",
        "required": [
          "repository_id",
          "repository_name",
          "criteria",
          "best_rank",
          "trajectory",
          "facts"
        ],
        "title": "TrendRepositorySchema"
      },
      "WatchKind": {
        "type": "string",
        "enum": [
          "vulnerability",
          "advisory",
          "paper",
          "release",
          "newsletter_article"
        ]
      },
      "WindowSchema": {
        "properties": {
          "days": {
            "type": "integer",
            "title": "Days"
          },
          "since": {
            "type": "string",
            "format": "date-time",
            "title": "Since"
          },
          "until": {
            "type": "string",
            "format": "date-time",
            "title": "Until"
          },
          "capped_kind": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/WatchKind"
              },
              {
                "type": "null"
              }
            ],
            "description": "The kind cut by the cap of the reading; null when nothing is cut."
          },
          "covered_after": {
