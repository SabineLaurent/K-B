# The secrets of the service api-ia of compose.yaml (issue #419). Copy to .env.api-ia (ignored by
# git) and fill in. Never commit real values. Each variable is described in .env.example.

# The resource of the model: https://<resource>.openai.azure.com/openai/v1
KB_LLM_BASE_URL=
KB_LLM_API_KEY=
# The key of kb digest, the client of the requests from the host. Make each key with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
KB_AI_API_KEY_KB_DIGEST=
# The key it sends to the data API: the same value as in .env.api-donnees.
KB_DATA_API_KEY_AI_DIGEST=
# The fine-grained GitHub token of the trend reports (docs/jeton-github.md).
KB_AI_GITHUB_TOKEN=
