# The secrets of the jobs create-db, collecte and import of compose.yaml (issue #419). Copy to
# .env.jobs (ignored by git) and fill in. Never commit real values. Each variable is described in
# .env.example.

# The base of the compose, read by create-db and import, with the password of .env.postgres:
#   postgresql://kb:<password>@postgres:5432/k_b
KB_DATABASE_URL=
# Optional, for the GitHub sources of kb collect: without it, 60 requests per hour.
KB_GITHUB_TOKEN=
