# The secrets of the C7 bench (time-knight wip/banc-c7/bench.py): copy to ~/REPO_GIT/K-B/.env.bench
# and fill there (K-B ignores .env.*); loaded by uv run --env-file, read by no file.

# Azure: the Foundry project every Azure model goes through; only the deployment name changes, in
# SERVICES of bench.py. The base URL keeps its path, as KB_LLM_BASE_URL of K-B
# (https://<resource>.openai.azure.com/openai/v1 or https://<resource>.services.ai.azure.com/openai/v1).
# Microsoft-Decision-1 takes the same key, at https://<resource host>/providers/microsoft/v1/systemone.
KB_BENCH_AZURE_BASE_URL=
KB_BENCH_AZURE_API_KEY=

# Google Cloud: the project id, and the location, eu (the EU multi-region, whose prices the bench
# uses) or global. No key: the token comes from gcloud auth print-access-token before each passage.
KB_BENCH_GCP_PROJECT=
KB_BENCH_GCP_LOCATION=
