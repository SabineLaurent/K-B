# Copy to .env.bench (ignored by git) and fill in. Never commit real values.
# The variables of the C7 bench alone (time-knight wip/banc-c7/bench.py), given to it by
#   uv run --env-file .env.bench python ~/REPO_GIT/time-knight/wip/banc-c7/bench.py run --cap-eur <cap>
# K-B reads none of them.

# Azure: the Foundry project every Azure model goes through; only the deployment name changes, in
# SERVICES of bench.py. The base URL keeps its path, as KB_LLM_BASE_URL in .env.example
# (https://<resource>.openai.azure.com/openai/v1 or https://<resource>.services.ai.azure.com/openai/v1).
# Both serve Microsoft-Decision-1 too: the same key, on the host of the URL, at
# https://<resource host>/providers/microsoft/v1/systemone.
KB_BENCH_AZURE_BASE_URL=
KB_BENCH_AZURE_API_KEY=

# Google Cloud: the project id, and the location, eu (the EU multi-region, whose prices the bench
# uses) or global. No key: the token comes from gcloud auth print-access-token before each passage.
KB_BENCH_GCP_PROJECT=
KB_BENCH_GCP_LOCATION=
